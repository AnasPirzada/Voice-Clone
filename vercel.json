{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9"
      }
    },
    {
      "src": "api/tts.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9"
      }
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.py"
    },
    {
      "src": "/tts",
      "dest": "/api/tts.py"
    },
    {
      "src": "/health",
      "dest": "/api/health.py"
    }
  ],
  "env": {
    "F5TTS_MODEL": "F5TTS_v1_Base",
    "F5TTS_DEVICE": "cpu"
  }
}
